proxy-groups:
  - name: 🚀 Proxy
    type: select
    proxies:
      - ♻️ Auto
      - 🎯 Direct

  - name: ♻️ Auto
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies: 
      - 'همکاری_ملی'
      - 'جاویدشاه'
      - 'KingRezaPahlavi'
      - '🇫🇮 FI | VLESS | @NamiraConfigs #1'
      - '🇵🇱 PL | VLESS | @NamiraConfigs #1'
      - '🇨🇭 CH | VLESS | @filtershekan_channel #1'
