proxy-groups:
  - name: 🚀 Proxy
    type: select
    proxies:
      - ♻️ Auto
      - 🎯 Direct

  - name: ♻️ Auto
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies: 
      - 'همکاری_ملی'
      - 'جاویدشاه'
      - 'KingRezaPahlavi'
      - '🇫🇮 FI | VLESS | @flyv2ray #1'
      - '🇷🇺 RU | VLESS | @flyv2ray #1'
      - '🇷🇺 RU | VLESS | @nofiltering2 #1'
