proxy-groups:
  - name: 🚀 Proxy
    type: select
    proxies:
      - ♻️ Auto
      - 🎯 Direct

  - name: ♻️ Auto
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies: 
      - 'همکاری_ملی'
      - 'جاویدشاه'
      - 'KingRezaPahlavi'
      - '🇨🇭 CH | VLESS | @filtershekan_channel #1'
      - '🇧🇬 BG | VLESS | @hope_net #1'
      - '🇺🇸 US | VLESS | @outline_ir #3'
