proxy-groups:
  - name: 🚀 Proxy
    type: select
    proxies:
      - ♻️ Auto
      - 🎯 Direct

  - name: ♻️ Auto
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies: 
      - 'همکاری_ملی'
      - 'جاویدشاه'
      - 'KingRezaPahlavi'
      - '🇷🇺 RU | VLESS | @nofiltering2 #1'
      - '🇸🇨 SC | VLESS | @orange_vpns #1'
      - '🇹🇼 TW | VLESS | @red2ray #1'
