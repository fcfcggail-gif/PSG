  - {"name": "🇸🇪 SE | VMESS | @outlinereleasedkey #1", "server": "138.199.55.230", "port": 1270, "type": "vmess", "skip-cert-verify": true, "uuid": "5c040f1d-45db-43bd-8d46-e4950e433735", "alterId": 0, "cipher": "auto", "network": "tcp", "tls": true}
