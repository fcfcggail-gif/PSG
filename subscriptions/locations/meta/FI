proxy-groups:
  - name: 🚀 Proxy
    type: select
    proxies:
      - ♻️ Auto
      - 🎯 Direct

  - name: ♻️ Auto
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies: 
      - '🇫🇮 FI | VLESS | @ehsawn8 #1'
      - '🇫🇮 FI | VLESS | @mimitdl #1'
