  - name: 🚀 Proxy
    type: select
    proxies:
      - ♻️ Auto
      - 🎯 Direct

  - name: ♻️ Auto
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies: 
      - '🇫🇷 FR | VLESS | @merdesert #1'
      - '🇫🇷 FR | VLESS | @minovpnch #1'
      - '🇫🇷 FR | VLESS | @minovpnch #2'
      - '🇫🇷 FR | VLESS | @mpproxy #1'
      - '🇫🇷 FR | VLESS | @privatevpns #1'
      - '🇫🇷 FR | VLESS | @privatevpns #2'
