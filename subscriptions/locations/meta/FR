proxy-groups:
  - name: 🚀 Proxy
    type: select
    proxies:
      - ♻️ Auto
      - 🎯 Direct

  - name: ♻️ Auto
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies: 
      - '🇫🇷 FR | VLESS | @flyv2ray #1'
      - '🇫🇷 FR | VLESS | @merdesert #1'
      - '🇫🇷 FR | VLESS | @minovpnch #1'
