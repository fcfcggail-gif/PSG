      - ♻️ Auto
      - 🎯 Direct

  - name: ♻️ Auto
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies: 
      - '🇵🇱 PL | VLESS | @bored_vpn #1'
      - '🇵🇱 PL | VLESS | @prrofile_purple #1'
      - '🇵🇱 PL | VLESS | @prrofile_purple #2'
