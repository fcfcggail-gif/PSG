  - name: 🚀 Proxy
    type: select
    proxies:
      - ♻️ Auto
      - 🎯 Direct

  - name: ♻️ Auto
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies: 
      - '🇳🇱 NL | VLESS | @NamiraConfigs #1'
      - '🇳🇱 NL | VLESS | @configv2rayforfree #1'
