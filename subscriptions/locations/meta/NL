proxy-groups:
  - name: 🚀 Proxy
    type: select
    proxies:
      - ♻️ Auto
      - 🎯 Direct

  - name: ♻️ Auto
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies: 
      - '🇳🇱 NL | VLESS | @orange_vpns #1'
      - '🇳🇱 NL | VLESS | @outline_ir #1'
      - '🇳🇱 NL | VLESS | @qeshmserver #1'
