proxy-groups:
  - name: 🚀 Proxy
    type: select
    proxies:
      - ♻️ Auto
      - 🎯 Direct

  - name: ♻️ Auto
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies: 
      - '🇳🇱 NL | VLESS | @NamiraConfigs #1'
      - '🇳🇱 NL | TROJAN | @manstervpn #1'
      - '🇳🇱 NL | VLESS | @mtproxy22_v2ray #1'
