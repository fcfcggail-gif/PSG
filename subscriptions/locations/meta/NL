proxy-groups:
  - name: 🚀 Proxy
    type: select
    proxies:
      - ♻️ Auto
      - 🎯 Direct

  - name: ♻️ Auto
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies: 
      - '🇳🇱 NL | VLESS | @filtershekan_channel #1'
      - '🇳🇱 NL | VLESS | @filtershekan_channel #2'
      - '🇳🇱 NL | VLESS | @mtproxy22_v2ray #1'
      - '🇳🇱 NL | VLESS | @mtproxy22_v2ray #2'
      - '🇳🇱 NL | VLESS | @orange_vpns #1'
      - '🇳🇱 NL | VMESS | @outlinereleasedkey #1'
      - '🇳🇱 NL | VLESS | @qeshmserver #1'
      - '🇳🇱 NL | VLESS | @red2ray #1'
      - '🇳🇱 NL | VLESS | @v2ray_collector #1'
      - '🇳🇱 NL | VLESS | @v2ray_youtube #1'
      - '🇳🇱 NL | VLESS | @v2rayprotocol #1'
      - '🇳🇱 NL | VLESS | @vpn_ioss #1'

  - name: 🌍 Global Media
    type: select
    proxies:
      - 🚀 Proxy
      - ♻️ Auto
      - 🎯 Direct

  - name: 🎯 Direct
    type: select
    proxies:
      - DIRECT

  - name: 🛑 Ad Block
    type: select
    proxies:
      - REJECT
      - DIRECT

  - name: 🐟 Fallback
    type: select
    proxies:
      - 🚀 Proxy
      - 🎯 Direct

rules:
  - DOMAIN-KEYWORD,adservice,🛑 Ad Block
  - DOMAIN-SUFFIX,googlesyndication.com,🛑 Ad Block
  - DOMAIN-SUFFIX,netflix.com,🌍 Global Media
  - DOMAIN-SUFFIX,nflxvideo.net,🌍 Global Media
  - DOMAIN-SUFFIX,disneyplus.com,🌍 Global Media
  - DOMAIN-KEYWORD,youtube,🌍 Global Media
  - DOMAIN-SUFFIX,t.me,🚀 Proxy
  - DOMAIN-SUFFIX,telegram.org,🚀 Proxy
  - DOMAIN-SUFFIX,openai.com,🚀 Proxy
  - DOMAIN-SUFFIX,lan,🎯 Direct
  - DOMAIN-SUFFIX,local,🎯 Direct
  - IP-CIDR,127.0.0.0/8,🎯 Direct,no-resolve
  - IP-CIDR,192.168.0.0/16,🎯 Direct,no-resolve
  - IP-CIDR,10.0.0.0/8,🎯 Direct,no-resolve
  - IP-CIDR,172.16.0.0/12,🎯 Direct,no-resolve
  - GEOIP,IR,🎯 Direct
  - MATCH,🐟 Fallback
