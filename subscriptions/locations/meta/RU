  - name: 🚀 Proxy
    type: select
    proxies:
      - ♻️ Auto
      - 🎯 Direct

  - name: ♻️ Auto
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies: 
      - '🇷🇺 RU | VLESS | @filtershekan_channel #1'
      - '🇷🇺 RU | VLESS | @jiedianf #1'
      - '🇷🇺 RU | VLESS | @mt_proxy #1'
