proxy-groups:
  - name: 🚀 Proxy
    type: select
    proxies:
      - ♻️ Auto
      - 🎯 Direct

  - name: ♻️ Auto
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies: 
      - '🇷🇺 RU | VLESS | @mtproxy22_v2ray #1'
      - '🇷🇺 RU | VLESS | @orange_vpns #1'
      - '🇷🇺 RU | VLESS | @prrofile_purple #1'
