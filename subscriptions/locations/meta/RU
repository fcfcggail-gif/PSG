proxy-groups:
  - name: 🚀 Proxy
    type: select
    proxies:
      - ♻️ Auto
      - 🎯 Direct

  - name: ♻️ Auto
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies: 
      - '🇷🇺 RU | VLESS | @flyv2ray #1'
      - '🇷🇺 RU | VLESS | @flyv2ray #2'
      - '🇷🇺 RU | VLESS | @flyv2ray #3'
