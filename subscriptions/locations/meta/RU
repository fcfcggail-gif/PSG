proxy-groups:
  - name: 🚀 Proxy
    type: select
    proxies:
      - ♻️ Auto
      - 🎯 Direct

  - name: ♻️ Auto
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies: 
      - '🇷🇺 RU | VLESS | @NamiraConfigs #1'
      - '🇷🇺 RU | VLESS | @NamiraConfigs #2'
      - '🇷🇺 RU | VLESS | @jiedianf #1'
      - '🇷🇺 RU | VLESS | @mt_proxy #1'
      - '🇷🇺 RU | VLESS | @nofiltering2 #1'
      - '🇷🇺 RU | VLESS | @nofiltering2 #2'
