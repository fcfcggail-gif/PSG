proxy-groups:
  - name: 🚀 Proxy
    type: select
    proxies:
      - ♻️ Auto
      - 🎯 Direct

  - name: ♻️ Auto
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies: 
      - '🇷🇺 RU | VLESS | @nofiltering2 #1'
      - '🇷🇺 RU | VLESS | @prrofile_purple #1'
      - '🇷🇺 RU | VLESS | @prrofile_purple #2'
