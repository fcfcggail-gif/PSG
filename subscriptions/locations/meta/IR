  - name: 🚀 Proxy
    type: select
    proxies:
      - ♻️ Auto
      - 🎯 Direct

  - name: ♻️ Auto
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies: 
      - '🇮🇷 IR | VLESS | @frev2rayng #1'
      - '🇮🇷 IR | VMESS | @khoneproxy #1'
      - '🇮🇷 IR | VLESS | @lemonshopvpn #1'
      - '🇮🇷 IR | VLESS | @miov2ray #1'
