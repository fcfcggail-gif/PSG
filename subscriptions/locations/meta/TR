  - {"name": "🇹🇷 TR | VLESS | @orange_vpns #1", "server": "gamitgr.vpxpp.ir", "port": 1819, "type": "vless", "skip-cert-verify": true, "uuid": "ea36bacb-7d11-4c2c-8998-f3ffd4cafd66", "network": "tcp", "tls": false, "udp": true, "client-fingerprint": "chrome"}
